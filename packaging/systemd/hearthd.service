[Unit]
Description=Hearth system manager and monitor
Documentation=https://github.com/mohammed-w-mosabeh/hearth

[Service]
Type=exec
ExecStart=/usr/bin/hearthd
Restart=on-failure
RestartSec=2s

# The sandbox below makes $HOME read-only, so create Hearth's directories
# first. "+" runs this one command outside the sandbox (still as the user).
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/.config/hearth %h/.local/share/hearth
ExecStartPre=+/usr/bin/mkdir -p %h/.config/systemd/user %h/.config/autostart

# --- Hardening (SECURITY.md "systemd hardening") ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Relaxation: hearthd writes its config/token and database, and the
# Scheduler's user jobs (hearth-job-* units in ~/.config/systemd/user; their
# scripts under ~/.local/share/hearth/jobs), and the Settings page's
# autostart entries (~/.config/autostart; files are rewritten, never
# deleted). Uses the XDG defaults; a custom XDG_CONFIG_HOME/XDG_DATA_HOME
# needs a drop-in.
ReadWritePaths=%h/.config/hearth %h/.local/share/hearth %h/.config/systemd/user %h/.config/autostart
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# AMD/Intel GPU stats come from sysfs and work with this. NVIDIA stats need
# nvidia-smi, which needs /dev/nvidia*: on NVIDIA machines add a drop-in with
# PrivateDevices=no, or GPU cards show identity only (untested: no hardware).
PrivateDevices=yes
KeyringMode=private
RemoveIPC=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
MemoryMax=80M
CPUQuota=10%
# Relaxation: anything hearthd launches for the user (apps, terminals) would
# inherit this sandbox, so the user manager starts it in its own unit, and
# the browser comes from the desktop portal (needs AF_UNIX to the user bus).
# Terminal shells: hearthd opens the pty (/dev/ptmx exists in the private
# /dev) and hands only the terminal's fd to a transient user unit over D-Bus.

[Install]
WantedBy=default.target
