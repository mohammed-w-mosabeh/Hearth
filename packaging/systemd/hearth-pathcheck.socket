[Unit]
Description=Hearth bind path check socket
Documentation=https://github.com/mohammed-w-mosabeh/hearth

[Socket]
# SECURITY S12b: only the broker (root) asks; one connection, one check.
ListenStream=/run/hearth/pathcheck.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
