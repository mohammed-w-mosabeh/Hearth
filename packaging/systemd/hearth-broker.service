[Unit]
Description=Hearth privileged helper
Documentation=https://github.com/mohammed-w-mosabeh/hearth
Requires=hearth-broker.socket
After=hearth-broker.socket

[Service]
Type=exec
ExecStart=/usr/bin/hearth-broker
# Started by the socket only; exits by itself after 60 s idle.
Restart=no
# Audit log (/var/lib/hearth/audit.jsonl); removed on purge.
StateDirectory=hearth
StateDirectoryMode=0700
UMask=0077

# --- Hardening (SECURITY.md "systemd hardening") ---
# It runs as root and needs no capabilities for most of what it does
# (answering on its socket, asking polkit over the system bus, writing its
# StateDirectory). Docker needs none either: /run/docker.sock is root's
# (connecting needs no write access to the read-only /run). Each method
# that needs a capability adds it here with a comment.
# disk.smart and disk.selftest (SECURITY S16f): ATA passthrough needs
# CAP_SYS_RAWIO and NVMe admin commands need CAP_SYS_ADMIN. Mounting,
# setuid and the like stay out of reach of the system call filter below.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# pkg.hold: apt-mark hold runs dpkg --set-selections, which rewrites
# dpkg's database (root-owned: no capability needed).
ReadWritePaths=/var/lib/dpkg
# apt.clean and journal.vacuum (SECURITY S16c): both directories' files are
# root's (no capability needed). "-": they may not exist.
ReadWritePaths=-/var/cache/apt/archives -/var/log/journal
# sched.*: root jobs' units, hearth-job-<id>.service/.timer (their scripts
# are in the StateDirectory, /var/lib/hearth/jobs/<id>/run, SECURITY S13).
# unit.override: <unit>.service.d/hearth.conf (S16d). The broker writes no
# other name there; root owns the directory, so no capability is needed.
ReadWritePaths=/etc/systemd/system
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices=yes: it hides the disks and drops CAP_SYS_RAWIO. The
# device policy is as closed: pseudo devices, plus SCSI/SATA disks and
# block-blkext (NVMe namespaces) for smartctl, nothing else. Partitions of
# those share the majors, but no method takes a path to one.
DevicePolicy=closed
DeviceAllow=block-sd rw
DeviceAllow=block-blkext rw
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Not ProtectProc=invisible: the broker reads the caller's /proc/<pid>/stat
# (start time) so polkit can identify the calling process. Nothing it runs
# needs the rest of /proc.
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Unix only: its socket and the system bus. No network at all.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=64M
CPUQuota=20%
TasksMax=64
