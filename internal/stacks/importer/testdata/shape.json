{
  "name": "shape",
  "networks": {
    "default": {
      "name": "shape_default",
      "ipam": {}
    },
    "front": {
      "name": "shape_front",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "container_name": "shape-app",
      "command": [
        "--pass",
        "s3cretvalue"
      ],
      "entrypoint": null,
      "environment": {
        "DB_PASSWORD": "s3cretvalue",
        "EXTRA": "fromfile",
        "TZ": "UTC"
      },
      "image": "nginx:1.27",
      "labels": {
        "a.b": "c"
      },
      "mem_limit": "536870912",
      "networks": {
        "front": null
      },
      "shm_size": "134217728",
      "stop_grace_period": "1m0s",
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/shape/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "volume",
          "source": "model",
          "target": "/models",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/etc/localtime",
          "target": "/etc/localtime",
          "read_only": true,
          "bind": {}
        }
      ],
      "depends_on": {
        "cache": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "expose": [
        "3000"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "true"
        ],
        "timeout": "5s",
        "interval": "1m30s",
        "retries": 3,
        "start_period": "10s"
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 90,
          "published": "9090",
          "protocol": "udp"
        }
      ],
      "stdin_open": true,
      "tty": true
    },
    "cache": {
      "command": null,
      "entrypoint": null,
      "image": "redis:7",
      "networks": {
        "default": null
      }
    }
  },
  "volumes": {
    "model": {
      "name": "shape_model"
    }
  }
}